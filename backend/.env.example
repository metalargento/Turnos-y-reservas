# ===========================================
# Sistema de Turnos y Reservas - Backend
# ===========================================

# --- App ---
APP_ENV=development
SECRET_KEY=your-secret-key-min-32-characters-long-for-signing

# --- Base de datos (Supabase PostgreSQL) ---
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Autenticación JWT ---
JWT_SECRET=your-jwt-secret-min-32-characters-long
JWT_EXPIRATION_MINUTES=60
REFRESH_TOKEN_EXPIRATION_DAYS=30

# --- Email transaccional (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=turnos@tu-dominio.com

# --- Mercado Pago (plugin de cobros) ---
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxxxxxxxx

# --- Google Calendar (opcional) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://tu-dominio.com/api/auth/google/callback

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend URL (para redirecciones) ---
FRONTEND_URL=http://localhost:5173

# --- Dominio de reservas públicas ---
RESERVAS_DOMAIN=http://localhost:5174
